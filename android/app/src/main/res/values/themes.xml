<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.DramaFlow" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">@color/cloud_white</item>
        <item name="android:navigationBarColor">@color/cloud_white</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <style name="Theme.DramaFlow.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/cloud_white</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/joyedrama_app_icon</item>
        <item name="windowSplashScreenAnimationDuration">0</item>
        <item name="postSplashScreenTheme">@style/Theme.DramaFlow</item>
    </style>
</resources>
