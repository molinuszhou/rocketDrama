# Copy to android/local.properties or protected CI secrets. Never commit real production values.
# The Release variant ships as com.feather.joyelledrama.

# Production rewards API. Must be a public HTTPS endpoint; do not use LAN or 10.0.2.2 in Release.
REWARDS_API_BASE_URL=https://rewards.example.com

# TopOn production mediation settings. TOPON_DEMO_MODE must be false for Release.
TOPON_DEMO_MODE=false
TOPON_APP_ID=
TOPON_APP_KEY=
TOPON_REWARDED_PLACEMENT_ID=
TOPON_INTERSTITIAL_PLACEMENT_ID=
TOPON_SPLASH_PLACEMENT_ID=
ADMOB_APP_ID=
# 10 seconds by default; permitted range is 1000–60000 milliseconds.
TOPON_REWARDED_LOAD_TIMEOUT_MS=10000

# AppsFlyer attribution. Organic installs take Release A; non-organic installs take Release B.
APPSFLYER_DEV_KEY=
RELEASE_AB_ROUTING_ENABLED=true

# External reporting (AppsFlyer, Firebase and Xuanyu). Verify each final provider endpoint before enabling.
EXTERNAL_REPORTING_ENABLED=true
ANALYTICS_DEBUG=false
XUANYU_EVENT_BASE_URL=https://your-final-xuanyu-endpoint.example

# Pangle short-drama SDK. Release forces SHORT_DRAMA_SDK_ENABLED=true and does not query the local Content API.
SHORT_DRAMA_SDK_ENABLED=true
SHORT_DRAMA_APP_ID=
SHORT_DRAMA_VOD_APP_ID=
# Path of the separately delivered license file beneath app/src/main/assets/, for example license/production.lic
SHORT_DRAMA_LICENSE_ASSET=
SHORT_DRAMA_SECURITY_KEY=

# Required protected files (excluded by .gitignore):
# 1) app/google-services.json registered for com.feather.joyelledrama
# 2) app/src/main/assets/<SHORT_DRAMA_LICENSE_ASSET>
# 3) local.properties
# 4) signing keystore and its passwords, kept outside the repository
