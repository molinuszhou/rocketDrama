# 复制到 android/local.properties 或受控 CI Secret；真实生产值禁止提交到 Git。
# Release 包名固定为 com.feather.joyelledrama。

# Rewards 正式公网 HTTPS 地址已固定编入 Release：
# https://www.joyelleasia.com/joyedrama-rewards
# 如需专用预发布地址，仅 Debug 构建可通过 REWARDS_API_BASE_URL 覆盖。

# TopOn 正式聚合参数。Release 强制 TOPON_DEMO_MODE=false。
TOPON_DEMO_MODE=false
TOPON_APP_ID=
TOPON_APP_KEY=
TOPON_REWARDED_PLACEMENT_ID=
TOPON_INTERSTITIAL_PLACEMENT_ID=
TOPON_SPLASH_PLACEMENT_ID=
# Android 的同一 applicationId 只能配置一个 AdMob App ID，格式必须为
# ca-app-pub-...~...。这是 Google Mobile Ads SDK 初始化参数，不是广告位 ID。
# 正式参数表中的另外两个 ca-app-pub-.../... 是 AdMob Ad Unit ID：请在 TopOn
# 瀑布流（或 TopOn 内 MAX Custom Network 的服务端 Extras）配置，禁止写入此文件或 Manifest。
ADMOB_APP_ID=
# 激励广告加载超时默认 10 秒，允许范围 1000–60000 毫秒。
TOPON_REWARDED_LOAD_TIMEOUT_MS=10000

# AppsFlyer 归因：Organic 进入 A 面，Non-organic 进入 B 面。
APPSFLYER_DEV_KEY=
RELEASE_AB_ROUTING_ENABLED=true

# 外部上报：AppsFlyer、Firebase、炫羽。完成三方联调后再开启。
EXTERNAL_REPORTING_ENABLED=true
ANALYTICS_DEBUG=false
# ADN/Appsflyer/Firebase/炫羽的本地 CSV 核对与导出仅存在于 Debug 包；Release 固定关闭，
# 不需要也不支持通过 local.properties 开启。
# 炫羽正式接口当前仅提供 HTTP。客户端仅对 api.eventtrack.top 放行明文流量；
# 请勿改成 HTTPS，也不要将其他域名加入明文白名单。
XUANYU_EVENT_BASE_URL=http://api.eventtrack.top

# Pangle 短剧 SDK。Release 固定启用，不请求本地 Content 服务。
SHORT_DRAMA_APP_ID=
SHORT_DRAMA_VOD_APP_ID=
# License 文件相对 app/src/main/assets/ 的路径，例如 license/production.lic。
SHORT_DRAMA_LICENSE_ASSET=
SHORT_DRAMA_SECURITY_KEY=

# 以下受控文件均已被 .gitignore 排除：
# 1) app/google-services.json，且必须注册到 com.feather.joyelledrama
# 2) app/src/main/assets/<SHORT_DRAMA_LICENSE_ASSET>
# 3) local.properties
# 4) 签名 keystore 与密码
