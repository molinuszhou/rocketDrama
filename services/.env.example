# JoyeDrama Windows 本地统一 Docker 测试环境。
# 在 services/ 目录复制为 .env 后填写；不要提交 .env 或把真实值写入 Android。

# PostgreSQL / 奖励服务
POSTGRES_DB=dramaflow_rewards
POSTGRES_USER=dramaflow
POSTGRES_PASSWORD=replace-with-a-long-local-test-password
POSTGRES_PORT=5432
REWARDS_PORT=8100

# 内容服务
CONTENT_PORT=8000
# Docker 宿主机上的片单绝对路径；Windows 建议使用正斜杠。
OWNED_CATALOG_PATH=D:/gworkspace/JoyeDrama/services/content/content/owned_catalog.local-media.json
# Docker 宿主机上的 MP4 根目录；容器内部固定映射到 /app/media。
LOCAL_MEDIA_ROOT=D:/gworkspace/JoyeDrama/services/content/media
LOCAL_MEDIA_ENABLED=true

# 本地媒体播放签名密钥：测试也请替换为随机字符串；生产环境必须使用独立受控密钥。
PLAYBACK_SIGNING_KEY=replace-with-a-long-local-playback-secret

# 开发阶段允许 Android Debug 包提交 TEST_PANGLE_REWARD；正式环境必须为 false。
ENVIRONMENT=development
ALLOW_DEBUG_AD_PROOF=true
PANGLE_CALLBACK_SECRET=
TIMEZONE=Asia/Shanghai
CORS_ORIGINS=http://localhost,http://10.0.2.2
CONTENT_CORS_ORIGINS=http://localhost,http://10.0.2.2

# 后续接入正式内容存储时再填写；当前局域网 local media 不需要。
FREE_DRAMA_DATABASE_URL=
FREE_DRAMA_CDN_BASE_URL=
