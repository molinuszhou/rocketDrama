# 独立积分服务。请勿将实际 .env 提交或发送到公开位置。
DATABASE_URL=postgresql://dramaflow:change-this-password@127.0.0.1:5432/dramaflow_rewards
HOST=0.0.0.0
PORT=8100
ENVIRONMENT=development
CORS_ORIGINS=http://localhost,http://10.0.2.2

# 开发环境仅允许 TEST_PANGLE_REWARD 作为本地联调证明；生产环境必须关闭。
ALLOW_DEBUG_AD_PROOF=true

# 生产环境由广告平台服务端回调/签名校验使用，当前留空。
PANGLE_CALLBACK_SECRET=

# 业务规则从 PostgreSQL 的 reward_policy 表读取；本期不提供配置文件或热更新后台。
TIMEZONE=Asia/Shanghai
