# Copy to .env.production on a host where Nginx already owns 80/443.
# Use with: docker compose --env-file .env.production -f docker-compose.nginx.yml up -d --build
# Never commit the copied .env.production file.
POSTGRES_DB=joyedrama_rewards
POSTGRES_USER=joyedrama
POSTGRES_PASSWORD=replace-with-a-long-random-postgres-password

# Bind only to localhost; the existing Nginx server proxies /joyedrama-rewards/ to this port.
REWARDS_BIND_PORT=18100
CORS_ORIGINS=https://www.joyelleasia.com
TIMEZONE=UTC

# Server-to-server rewarded callback verifier. Never expose this to Android.
PANGLE_CALLBACK_SECRET=replace-with-provider-server-callback-secret
# Protect /admin and /v2/admin/*.
ADMIN_DASHBOARD_TOKEN=replace-with-a-long-random-admin-token
