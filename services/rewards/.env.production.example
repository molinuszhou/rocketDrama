# 复制为 .env.production 后填写真实值；该文件仅适用于已由宿主机原生 Nginx 管理 HTTPS 的服务器。
# 不要提交 .env.production。
POSTGRES_DB=joyedrama_rewards
POSTGRES_USER=joyedrama
POSTGRES_PASSWORD=替换为高强度PostgreSQL密码

# Rewards API 与管理后台均仅监听本机回环地址；Nginx 按路径代理到各自端口。
REWARDS_BIND_PORT=18100
# 管理 UI 与 /v2/admin/* 使用的独立服务端口。
REWARDS_ADMIN_BIND_PORT=18101
# 保持空值时使用下方 Compose 内的 postgres 容器。未来迁移 RDS 时填完整 TLS PostgreSQL URL。
REWARDS_DATABASE_URL=
CORS_ORIGINS=https://www.joyelleasia.com
TIMEZONE=UTC

# MaxMind GeoLite2-Country.mmdb 的宿主机路径；只保存解析后的两位国家代码，不保存原始 IP。
GEOIP_DB_HOST_PATH=./geoip/GeoLite2-Country.mmdb
GEOIP_DB_PATH=/usr/share/GeoIP/GeoLite2-Country.mmdb

# 保护 /admin 与 /v2/admin/*；使用长随机字符串，仅保存于服务器。
ADMIN_DASHBOARD_TOKEN=替换为高强度后台管理令牌

# 用户会话签名密钥；必须是与后台令牌不同的高强度随机字符串。
SESSION_SIGNING_SECRET=替换为另一条高强度随机字符串
# 用户会话默认有效 180 天（允许 1–730 天）；bootstrap 续签不要求旧令牌有效。
# 新客户端在会话失效/签名密钥轮换后无感续签，保留原事件 ID 并仅重放一次原请求。
# 不要在每次发版时重生成 SESSION_SIGNING_SECRET；后台管理员会话使用独立的较短期限。
USER_SESSION_TTL_DAYS=180
# 受限原始审计（原始 IP 14 天、AppsFlyer 完整 conversion payload 30 天）的 Fernet 密钥。
# 在可信管理终端执行：python3 -c "import base64,os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# 仅保存在服务器 .env.production，绝不提交、绝不用于 CSV 导出；未设置时服务仍启动，但拒绝保存原始敏感字段。
TELEMETRY_ENCRYPTION_KEY=替换为Fernet生成的密钥
# 新版 Android 全量发布并完成回归后设为 true，拒绝不带服务端会话的新协议写请求。
# 保持 false 时仍兼容旧客户端，但旧客户端请求无法获得会话防伪保护。
REWARDS_REQUIRE_USER_SESSION=false
# 首次部署时可用来自动创建后台账号；创建后可从环境变量移除，密码只保存为哈希。
ADMIN_INITIAL_USERNAME=admin
ADMIN_INITIAL_PASSWORD=首次登录后请从服务器环境中移除
