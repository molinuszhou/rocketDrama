# Copy to .env.production on the AWS host. Do not commit the copied file.
# If Nginx already owns ports 80/443, use .env.nginx.example together with
# docker-compose.nginx.yml instead of this Caddy-oriented template.
POSTGRES_DB=joyedrama_rewards
POSTGRES_USER=joyedrama
POSTGRES_PASSWORD=replace-with-a-long-random-postgres-password

# Public DNS record must point to the AWS host before starting Caddy for ACME TLS.
REWARDS_DOMAIN=rewards.example.com
ACME_EMAIL=operations@example.com
CORS_ORIGINS=https://rewards.example.com
TIMEZONE=UTC

# Server-to-server rewarded callback verifier. Obtain the exact signing secret / callback value
# from the production TopOn/Pangle integration. Never expose this in the Android project.
PANGLE_CALLBACK_SECRET=replace-with-provider-server-callback-secret

# Protect /admin and /v2/admin/*; use a long random value stored only on the host.
ADMIN_DASHBOARD_TOKEN=replace-with-a-long-random-admin-token
